# Copia este archivo como .env y llena los valores (ver SETUP.md).
# Estas variables EXPO_PUBLIC_ son públicas: van dentro de la app. Nunca pongas aquí llaves secretas.

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-o-publishable-key

# Google Cloud → APIs & Services → Credentials (OAuth 2.0 Client IDs)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=1234567890-yyyy.apps.googleusercontent.com

# Opcional: cuenta de Expo y proyecto de EAS
# EXPO_OWNER=remakenet
# EAS_PROJECT_ID=
